                      "x": {
                        "type": "number",
                        "description": "World position in meters; Y is up."
                      },
                      "z": {
                        "type": "number",
                        "description": "World position in meters; Y is up."
                      },
                      "yaw": {
                        "type": "number",
                        "description": "World position in meters; Y is up."
                      }
                    },
                    "required": [
                      "id",
                      "surface",
                      "x",
                      "z",
                      "yaw"
                    ],
                    "additionalProperties": false
                  },
